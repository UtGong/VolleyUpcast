{
  "name": "volley-upcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coach-reviewed local volleyball scene research prototype",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/check.mjs && prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
